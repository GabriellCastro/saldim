# Copie para .env (fica fora do git): cp .env.example .env

# Banco
POSTGRES_USER=saldim
POSTGRES_PASSWORD=saldim
POSTGRES_DB=saldim
DATABASE_URL=postgresql://saldim:saldim@localhost:5432/saldim?schema=public

# API
API_PORT=3333
# troque por um valor aleatório fora do dev: openssl rand -hex 32
JWT_SECRET=troque-este-segredo
# origens que podem chamar a API (separadas por vírgula)
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
# prefixo quando a API fica atrás de um proxy em /api (deixe vazio em dev)
API_BASE_PATH=
# docker: roda o seed (usuário demo) ao subir a API. Use false fora do dev: o seed redefine a senha do demo
SEED_ON_START=true

# Cadastro: true deixa qualquer pessoa criar conta em /registro; false fecha (API responde 403 e a tela volta pro login)
REGISTRATION_OPEN=true

# Regras pessoais do categorizador, antes das genéricas: REGEX=categoria[:in|out] separadas por ";"
# Compara com a descrição em maiúsculas e sem acento. Ex.: "PIX TRANSF FULANO=propria;PIX TRANSF CICLANA=moradia:out"
# Categorias em apps/api/src/categories/categories.ts. O extrato de exemplo do seed usa a linha abaixo.
CATEGORY_RULES="PIX TRANSF LUCAS=propria;FINANC MOTO=moto;LOJA CELULAR=celular"

# Opcional: habilita respostas reais do Assistente IA (sem chave usa respostas por regras)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# cotação usada pra mostrar o gasto da IA em reais no perfil
USD_BRL=5.40

# Web
NEXT_PUBLIC_API_URL=http://localhost:3333

# Opcional: Open Finance (Pluggy) — dashboard.pluggy.ai → Applications
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# webhook: URL pública da API + um segredo qualquer
PLUGGY_WEBHOOK_URL=
PLUGGY_WEBHOOK_SECRET=
